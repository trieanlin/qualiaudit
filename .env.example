# Copy this file to .env for local server-side development only.
# The default local deterministic reviewer does not require a key.
# Never rename a secret with a VITE_ prefix: Vite exposes those values to the browser bundle.
OPENAI_API_KEY=
# No model is assumed silently. Set an available Responses API model explicitly.
OPENAI_MODEL=
# A key and model are not enough: intentionally opt this deployment in.
QUALIAUDIT_ENABLE_REMOTE_REVIEW=false
# Human-readable deployment/account configuration shown before consent; not a routing control.
QUALIAUDIT_OPENAI_REGION=
